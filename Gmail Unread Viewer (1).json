    {
      "parameters": {
        "functionCode": "return items.map(item => {\n  const json = item.json;\n\n  // Extraer campos principales\n  const id = json.id || '';\n  const subject = json.subject || '';\n  const date = json.date || '';\n  const text = json.text || '';\n\n  // Extraer el remitente (from)\n  let from = '';\n  if (json.from?.value && json.from.value.length > 0) {\n    const f = json.from.value[0];\n    from = f.name ? `${f.name} <${f.address}>` : f.address;\n  }\n\n  // Extraer destinatarios (to) si quieres\n  let to = '';\n  if (json.to?.value && json.to.value.length > 0) {\n    to = json.to.value.map(t => t.name ? `${t.name} <${t.address}>` : t.address).join(', ');\n  }\n\n  return {\n    json: {\n      id: id,\n      from: from,\n      to: to,\n      subject: subject,\n      text: text,\n      date: date\n    }\n  };\n});\n"
      },
